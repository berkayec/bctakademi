{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "biomed-tech-hub-b_kwvedxzqodh42y7pqeb",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-24",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "!/api/docs/*"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bctakademi-db",
			"database_id": "5d669293-c53e-4ba7-83ec-49b74d547ee0"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "bctakademi-files"
		}
	]
}
